# Copy to .env and fill in your own location and MoEP station IDs.
# .env is private and ignored by Git. Never put an address in AIR_PLACE.
AIR_HOME_LAT=
AIR_HOME_LON=
AIR_PLACE="איכות האוויר"

# Required: nearby air monitoring stations (comma-separated IDs).
AIR_LOCAL_STATION_IDS=
AIR_LOCAL_RADIUS_KM=3

# Optional: wind stations, in priority order. Empty = Open-Meteo forecast.
AIR_WIND_STATION_IDS=

# Optional Haifa Bay source groups. Empty = no warning for that source.
# Only add these if they are relevant to your location.
AIR_BAZAN_STATION_IDS=
AIR_TASHAN_STATION_IDS=
